# Supabase
DATABASE_URL=postgresql://postgres:[password]@[project-ref].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-key]
SUPABASE_SERVICE_ROLE_KEY=[service-role-key]

# Moneroo (Sandbox pour le développement)
MONEROO_SECRET_KEY=[sandbox-secret-key]
MONEROO_PUBLIC_KEY=[sandbox-public-key]
# Secret du webhook Moneroo (dashboard Moneroo > Webhooks) : sert à vérifier la signature X-Moneroo-Signature
MONEROO_WEBHOOK_SECRET=[webhook-secret]

# Resend
RESEND_API_KEY=[resend-api-key]

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
